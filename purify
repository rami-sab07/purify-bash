#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

readonly SCRIPT_NAME="${0##*/}"
readonly MODEL_NAME="Kim_Vocal_2.onnx"
readonly SUPPORTED_EXTENSIONS="avi|flac|m4a|mka|mkv|mov|mp3|mp4|mpeg|mpg|ogg|opus|wav|webm"
WORKSPACE=""
SELECTED_STREAM=""
SELECTED_STREAM_TITLE=""
OUTPUT_TEMP=""
VERBOSE=false

if [[ -t 1 ]]; then
  readonly BLUE=$'\033[1;34m'
  readonly GREEN=$'\033[1;32m'
  readonly RED=$'\033[1;31m'
  readonly RESET=$'\033[0m'
else
  readonly BLUE=""
  readonly GREEN=""
  readonly RED=""
  readonly RESET=""
fi

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME PATH_OR_URL [...]

Remove music from local media files, directories, YouTube videos, and playlists.
Generated files are written beside their source with a " (Purified)" suffix.

Options:
  -r, --recursive  Search directories and their subdirectories.
  -o, --override   Replace local input files after successful processing.
  -q, --quality    Maximum video height to download (default: 720p).
  -v, --verbose    Show detailed output from each processing stage.
      --mpv        Open each result in MPV after successful processing.
  -h, --help       Show this help message.
EOF
}

status() {
  printf '%s%s%s\n' "$BLUE" "$*" "$RESET"
}

fail() {
  printf '%sError: %s%s\n' "$RED" "$*" "$RESET" >&2
  return 1
}

is_url() {
  [[ "$1" =~ ^https?:// ]]
}

is_supported_media() {
  [[ "$1" =~ \.($SUPPORTED_EXTENSIONS)$ ]]
}

require_commands() {
  local launch_mpv=$1
  local command_name
  for command_name in yt-dlp ffmpeg ffprobe audio-separator; do
    command -v "$command_name" >/dev/null 2>&1 || {
      fail "'$command_name' is required but was not found on PATH."
      return 1
    }
  done
  if [[ "$launch_mpv" == true ]]; then
    command -v mpv >/dev/null 2>&1 || {
      fail "'mpv' is required when using --mpv but was not found on PATH."
      return 1
    }
  fi
}

download_url() {
  local url=$1
  local quality=$2
  local printed_path file
  local -a logging_args=(--no-warnings)
  printed_path=$(mktemp "${TMPDIR:-/tmp}/purify-download.XXXXXX")
  [[ "$VERBOSE" == true ]] && logging_args=(--verbose)
  status "Fetching $url" >&2
  if ! yt-dlp \
      --progress \
      "${logging_args[@]}" \
      --restrict-filenames \
      --no-overwrites \
      --format "bestvideo[height<=${quality}]+bestaudio/best[height<=${quality}]" \
      -o '%(title)s [%(id)s].%(ext)s' \
      --print-to-file after_move:filepath "$printed_path" \
      "$url" 1>&2; then
    rm -f -- "$printed_path"
    return 1
  fi
  while IFS= read -r file; do
    [[ -f "$file" ]] && printf '%s\n' "$file"
  done < "$printed_path"
  rm -f -- "$printed_path"
}

collect_local_files() {
  local input=$1
  local recursive=$2
  local file
  if [[ -f "$input" ]]; then
    is_supported_media "${input,,}" && printf '%s\n' "$input"
    return 0
  fi

  if [[ -d "$input" ]]; then
    if [[ "$recursive" == true ]]; then
      while IFS= read -r -d '' file; do
        [[ "$file" == *" (Purified)"* ]] && continue
        is_supported_media "${file,,}" && printf '%s\n' "$file"
      done < <(find "$input" -type f -print0)
    else
      while IFS= read -r -d '' file; do
        [[ "$file" == *" (Purified)"* ]] && continue
        is_supported_media "${file,,}" && printf '%s\n' "$file"
      done < <(find "$input" -maxdepth 1 -type f -print0)
    fi
    return 0
  fi

  fail "Input does not exist: $input"
}

select_audio_stream() {
  local source=$1
  local -a audio_streams
  local stream_number
  local selection
  local selected_ordinal

  mapfile -t audio_streams < <(
    ffprobe -v error -select_streams a \
      -show_entries stream=index \
      -of csv=p=0 "$source"
  )
  ((${#audio_streams[@]} > 0)) ||
    fail "No audio stream was found in '$source'."

  if ((${#audio_streams[@]} == 1)); then
    SELECTED_STREAM=${audio_streams[0]}
    selected_ordinal=0
  else
    printf 'Multiple audio streams found in %s:\n' "$source"
    for stream_number in "${!audio_streams[@]}"; do
      printf '  %d) stream %s\n' "$((stream_number + 1))" "${audio_streams[stream_number]}"
    done

    while true; do
      read -r -p "Select an audio stream [1-${#audio_streams[@]}]: " selection ||
        fail "Audio stream selection was cancelled."
      if [[ "$selection" =~ ^[0-9]+$ ]] &&
        ((selection >= 1 && selection <= ${#audio_streams[@]})); then
        SELECTED_STREAM=${audio_streams[selection - 1]}
        selected_ordinal=$((selection - 1))
        break
      fi
      printf 'Please enter a number from 1 to %d.\n' "${#audio_streams[@]}" >&2
    done
  fi

  SELECTED_STREAM_TITLE=$(
    ffprobe -v error -select_streams "a:$selected_ordinal" \
      -show_entries stream_tags=title \
      -of default=nw=1:nk=1 "$source"
  )
  if [[ -z "$SELECTED_STREAM_TITLE" || "$SELECTED_STREAM_TITLE" == "N/A" ]]; then
    SELECTED_STREAM_TITLE="Audio"
  fi
  return 0
}

output_path_for() {
  local source=$1
  local directory filename stem extension candidate suffix counter
  directory=$(dirname "$source")
  filename=$(basename "$source")
  stem=${filename%.*}
  extension=${filename##*.}
  candidate="$directory/$stem (Purified).$extension"
  counter=2

  while [[ -e "$candidate" ]]; do
    candidate="$directory/$stem (Purified $counter).$extension"
    ((counter++))
  done
  printf '%s\n' "$candidate"
}

find_vocals_stem() {
  local workspace=$1
  local stem
  while IFS= read -r -d '' stem; do
    printf '%s\n' "$stem"
    return 0
  done < <(find "$workspace" -type f \( -iname '*vocals*.wav' -o -iname '*vocal*.wav' \) -print0)
  fail "audio-separator did not produce a Vocals WAV stem."
}

audio_codec_for() {
  case "${1,,}" in
    mp3) printf '%s\n' libmp3lame ;;
    flac) printf '%s\n' flac ;;
    wav) printf '%s\n' pcm_s16le ;;
    ogg|opus|webm) printf '%s\n' libopus ;;
    *) printf '%s\n' aac ;;
  esac
}

cleanup() {
  if [[ -n "$WORKSPACE" && -d "$WORKSPACE" ]]; then
    rm -rf -- "$WORKSPACE"
    WORKSPACE=""
  fi
  if [[ -n "$OUTPUT_TEMP" && -e "$OUTPUT_TEMP" ]]; then
    rm -f -- "$OUTPUT_TEMP"
    OUTPUT_TEMP=""
  fi
}

trap cleanup EXIT

launch_mpv() {
  local result=$1
  status "Launching MPV for $result"
  mpv -- "$result" >/dev/null 2>&1 </dev/null &
}

process_media() {
  local source=$1
  local replace_original=$2
  local launch_mpv_after=$3
  local vocals output result extension codec stream_number duration
  local ffmpeg_log_level=warning separator_log_level=error
  local -a audio_count disposition_args separator_args

  [[ -f "$source" ]] || {
    printf 'Skipping missing downloaded file: %s\n' "$source" >&2
    return 0
  }
  is_supported_media "${source,,}" || return 0

  WORKSPACE=$(mktemp -d "${TMPDIR:-/tmp}/purify.XXXXXX")
  if [[ "$VERBOSE" == true ]]; then
    ffmpeg_log_level=info
    separator_log_level=info
  fi

  status "Inspecting $source"
  select_audio_stream "$source"
  status "Extracting audio"
  ffmpeg -hide_banner -loglevel "$ffmpeg_log_level" -stats -y \
    -i "$source" -map "0:$SELECTED_STREAM" -vn -acodec pcm_s16le \
    "$WORKSPACE/input.wav"

  status "Separating vocals"
  duration=$(ffprobe -v error -show_entries format=duration \
    -of default=nw=1:nk=1 "$source")
  separator_args=(
    "$WORKSPACE/input.wav"
    --model_filename "$MODEL_NAME" \
    --output_dir "$WORKSPACE" \
    --output_format WAV \
    --mdx_batch_size 4 \
    --log_level "$separator_log_level" \
    --single_stem Vocals
  )
  if awk "BEGIN { exit !($duration > 2400) }"; then
    separator_args+=(--chunk_duration 600)
  fi
  audio-separator "${separator_args[@]}"
  vocals=$(find_vocals_stem "$WORKSPACE")
  if [[ "$replace_original" == true ]]; then
    output=$source
    extension=${source##*.}
    OUTPUT_TEMP=$(mktemp "$WORKSPACE/output.XXXXXX.$extension")
    output=$OUTPUT_TEMP
  else
    output=$(output_path_for "$source")
  fi

  if ffprobe -v error -select_streams v:0 -show_entries stream=index \
    -of csv=p=0 "$source" | grep -q .; then
    mapfile -t audio_count < <(
      ffprobe -v error -select_streams a \
        -show_entries stream=index -of csv=p=0 "$source"
    )
    disposition_args=()
    for ((stream_number = 0; stream_number < ${#audio_count[@]}; stream_number++)); do
      disposition_args+=("-disposition:a:$stream_number" "0")
    done
    disposition_args+=("-disposition:a:${#audio_count[@]}" "default")

    extension=${source##*.}
    if [[ "${extension,,}" == "webm" ]]; then
      codec=libopus
    else
      codec=aac
    fi
    status "Merging purified audio into video"
    ffmpeg -hide_banner -loglevel "$ffmpeg_log_level" -stats -y \
      -i "$source" -i "$vocals" \
      -map 0:v? -map 0:a? -map 1:a:0 \
      -map_metadata 0 -c:v copy -c:a "$codec" -b:a 192k \
      "${disposition_args[@]}" \
      -metadata:s:a:"${#audio_count[@]}" "title=${SELECTED_STREAM_TITLE} (Purified)" \
      "$output"
  else
    codec=$(audio_codec_for "${source##*.}")
    status "Encoding purified audio"
    ffmpeg -hide_banner -loglevel "$ffmpeg_log_level" -stats -y \
      -i "$vocals" -map 0:a:0 -c:a "$codec" "$output"
  fi

  if [[ "$replace_original" == true ]]; then
    mv -- "$output" "$source"
    OUTPUT_TEMP=""
    result=$source
    printf '%sReplaced %s%s\n' "$GREEN" "$source" "$RESET"
  else
    result=$output
    printf '%sCreated %s%s\n' "$GREEN" "$output" "$RESET"
  fi
  [[ "$launch_mpv_after" == true ]] && launch_mpv "$result"
  cleanup
}

main() {
  local input file quality=720 recursive=false override=false launch_mpv_after=false
  local -a files=()
  declare -A replace_original=()

  if (($# == 0)); then
    usage >&2
    return 2
  fi
  while (($# > 0)); do
    case "$1" in
      -h|--help)
        usage
        return 0
        ;;
      -r|--recursive)
        recursive=true
        shift
        ;;
      -o|--override)
        override=true
        shift
        ;;
      -q|--quality)
        if (($# < 2)); then
          fail "Option $1 requires a value."
          return 2
        fi
        quality=${2%p}
        [[ "$quality" =~ ^[1-9][0-9]*$ ]] || {
          fail "Invalid video quality: $2"
          return 2
        }
        shift 2
        ;;
      -v|--verbose)
        VERBOSE=true
        shift
        ;;
      --mpv)
        launch_mpv_after=true
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        fail "Unknown option: $1"
        return 2
        ;;
      *)
        break
        ;;
    esac
  done
  (($# > 0)) || {
    usage >&2
    return 2
  }

  require_commands "$launch_mpv_after"
  for input in "$@"; do
    if is_url "$input"; then
      while IFS= read -r file; do
        if [[ -n "$file" ]]; then
          files+=("$file")
          replace_original["$file"]=true
        fi
      done < <(download_url "$input" "$quality")
    else
      while IFS= read -r file; do
        if [[ -n "$file" ]]; then
          files+=("$file")
          [[ "$override" == true ]] && replace_original["$file"]=true
        fi
      done < <(collect_local_files "$input" "$recursive")
    fi
  done

  ((${#files[@]} > 0)) || fail "No supported media files were found."
  for file in "${files[@]}"; do
    process_media "$file" "${replace_original[$file]:-false}" "$launch_mpv_after"
  done
}

main "$@"
